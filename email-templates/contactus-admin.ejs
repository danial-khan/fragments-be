<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New contact form - Fragments</title>
    <%- include('./partials/styles') %>
  </head>
  <body class="email-body" style="margin:0;padding:32px 16px;background-color:#e0f2fe;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <div class="email-wrap">
      <div class="email-card">
        <div class="email-accent-strip"></div>
        <div class="email-inner">
          <p class="email-brand">Fragments</p>
          <h1 class="email-title">New contact form submission</h1>
          <p class="email-p email-p-left" style="margin-bottom:20px;">
            Someone submitted the contact form with the following details:
          </p>
          <table class="email-table" role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <th>Name</th>
              <td><%= name %></td>
            </tr>
            <tr>
              <th>Email</th>
              <td><a href="mailto:<%= email %>" style="color:#1e40af;"><%= email %></a></td>
            </tr>
            <tr>
              <th>Subject</th>
              <td><%= subject %></td>
            </tr>
            <tr>
              <th>Message</th>
              <td><%= message %></td>
            </tr>
          </table>
          <div class="email-footer">
            Please follow up with the user when you can.
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
