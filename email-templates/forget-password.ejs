<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password - Fragments</title>
    <%- include('./partials/styles') %>
  </head>
  <body class="email-body" style="margin:0;padding:32px 16px;background-color:#e0f2fe;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <div class="email-wrap">
      <div class="email-card">
        <div class="email-accent-strip"></div>
        <div class="email-inner">
          <p class="email-brand">Fragments</p>
          <h1 class="email-title">Reset your password</h1>
          <p class="email-p">Hi <%= name %>,</p>
          <p class="email-p">
            We received a request to reset the password for your account. Click the button below to choose a new password.
          </p>
          <div class="email-cta-wrap">
            <a
              class="email-btn"
              href="<%= resetURL %>"
              style="display:inline-block;background:#f59e0b;color:#ffffff!important;font-weight:600;font-size:15px;padding:14px 28px;border-radius:8px;text-decoration:none!important;border:1px solid #d97706;"
              >Reset password</a
            >
          </div>
          <p class="email-p" style="font-size:13px;color:#64748b;margin-top:20px;">
            If the button doesn’t work, copy and paste this link into your browser:<br />
            <span style="word-break:break-all;color:#3b82f6;"><%= resetURL %></span>
          </p>
          <div class="email-footer">
            If you didn’t request a reset, you can ignore this email — your password will stay the same.
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
