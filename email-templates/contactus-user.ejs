<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>We received your message - Fragments</title>
    <%- include('./partials/styles') %>
  </head>
  <body class="email-body" style="margin:0;padding:32px 16px;background-color:#e0f2fe;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <div class="email-wrap">
      <div class="email-card">
        <div class="email-accent-strip"></div>
        <div class="email-inner">
          <p class="email-brand">Fragments</p>
          <h1 class="email-title">Thanks for reaching out</h1>
          <p class="email-p">Hi <%= name %>,</p>
          <p class="email-p">
            We’ve received your message and will get back to you as soon as we can. Here’s a copy of what you sent:
          </p>
          <div class="email-box">
            <strong style="color:#1e293b;">Subject:</strong> <%= subject %><br /><br />
            <strong style="color:#1e293b;">Message:</strong><br />
            <%= message %>
          </div>
          <div class="email-footer">
            Need something urgent? Reply to this email or contact support through the site.
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
