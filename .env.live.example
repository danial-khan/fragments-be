# Copy to .env.live and fill with production Stripe keys (Dashboard → Developers → API keys → Live mode)
# Never commit .env.live to git.

STRIPE_SECRET=sk_live_your_secret_key_here
# Must match route GET /subscriptions/success/:session_id (Stripe replaces {CHECKOUT_SESSION_ID})
STRIPE_SUCCESS_CALLBACK_URL=https://api.fragmenttrails.com/subscriptions/success
